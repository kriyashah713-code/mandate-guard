# Mandate Guard — Environment Variables Reference
# Never put real secrets or private API keys in VITE_* variables,
# as Vite embeds all VITE_* variables into the client bundle.

# Public application URL (optional, used for canonical metadata if configured)
VITE_APP_URL=

# Deployment environment label (production | preview | development)
VITE_APP_ENV=production

# Optional server-side only secret (never prefix with VITE_ or expose in frontend)
GEMINI_API_KEY=
